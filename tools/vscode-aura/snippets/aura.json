{
  "Class": {
    "prefix": "class",
    "body": [
      "class ${1:Name}:",
      "    ${2:field}: ${3:Type}"
    ],
    "description": "Aura class declaration"
  },
  "Function": {
    "prefix": "def",
    "body": [
      "def ${1:name}(${2:param}: ${3:Type}) -> ${4:None}:",
      "    ${5:return None}"
    ],
    "description": "Aura function declaration"
  },
  "Lambda": {
    "prefix": "lambda",
    "body": [
      "lambda ${1:value}: ${2:expression}"
    ],
    "description": "Aura expression lambda"
  },
  "Loan capture lambda": {
    "prefix": "lambda-view",
    "body": [
      "lambda [${1:value}, mut ${2:state}, own ${3:snapshot}] ${4:item}: ${5:expression}"
    ],
    "description": "Aura lambda with an exhaustive shared, mutable, and owned capture list"
  },
  "Shared view": {
    "prefix": "view",
    "body": [
      "view ${1:name} = ${2:place}"
    ],
    "description": "Aura inferred shared view binding"
  },
  "Mutable view": {
    "prefix": "view-mut",
    "body": [
      "view mut ${1:name} = ${2:place}"
    ],
    "description": "Aura inferred mutable write-through view binding"
  },
  "Returned view function": {
    "prefix": "def-view",
    "body": [
      "def ${1:name}(${2:origin}: ${3:Type}) -> view ${4:ResultType} from ${2:origin}:",
      "    return view ${2:origin}.${5:field}"
    ],
    "description": "Aura function returning a shared view tied to one origin"
  },
  "Multiline string": {
    "prefix": "triple",
    "body": [
      "\"\"\"${1:text}\"\"\""
    ],
    "description": "Aura exact multiline string"
  },
  "Formatted string": {
    "prefix": "fstr",
    "body": [
      "f\"${1:label}: {${2:value}:${3:>10}}\""
    ],
    "description": "Aura formatted string with a static format specification"
  },
  "Extern C function": {
    "prefix": "externc",
    "body": [
      "public extern \"C\" def ${1:name}(${2}) -> ${3:int32}"
    ],
    "description": "Aura FFI v0 C function declaration"
  },
  "Extern C opaque handle": {
    "prefix": "externhandle",
    "body": [
      "public extern \"C\" opaque class ${1:Handle}"
    ],
    "description": "Aura FFI v0 opaque C handle declaration"
  },
  "If": {
    "prefix": "if",
    "body": [
      "if ${1:condition}:",
      "    ${2:# TODO}"
    ],
    "description": "Aura if block"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "match ${1:value}:",
      "    case ${2:Pattern}:",
      "        ${3:# TODO}"
    ],
    "description": "Aura match block"
  },
  "With": {
    "prefix": "with",
    "body": [
      "with ${1:expr} as ${2:name}:",
      "    ${3:# TODO}"
    ],
    "description": "Aura with block"
  }
}
